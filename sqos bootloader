[bits 16]
[org 0x7c00]

start:
    xor ax, ax
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov sp, 0x7c00

    mov si, msg
    mov ah, 0x0e

print_loop:
    lodsb
    test al, al
    jz halt
    int 0x10
    jmp print_loop

halt:
    cli
    hlt
    jmp halt

msg db 'SQOS', 0

times 510-($-$$) db 0
dw 0xaa55
